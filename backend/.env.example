# TruthGraph Backend Environment Configuration
SERPAPI_API_KEY=your_serpapi_api_key_here
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
DATABASE_URL=sqlite:///./truthgraph.db
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/truthgraph?retryWrites=true&w=majority
MAX_SEARCHES_PER_INVESTIGATION=10
